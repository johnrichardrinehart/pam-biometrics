{
  "version": 1,
  "defaults": {
    "combine": "all",
    "on_no_decision": "deny",
    "timeout_seconds": 20,
    "wait_message": "Touch the fingerprint reader and press Super+Alt+F (20 s)."
  },
  "services": {
    "login": { "factors": [] },
    "hyprlock": { "factors": ["fingerprint"], "on_no_decision": "allow" }
  }
}
